---
import '../styles/global.css';
import ProblemList from '../components/ProblemList.astro';
import Footer from '../components/Footer.astro';
import { problems, idToSlug } from '../lib/problems.ts';
import { THEME_INIT } from '../lib/theme.ts';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const slugs = problems.map((p) => idToSlug(p.id));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Python Interview Prep</title>
    <script is:inline set:html={THEME_INIT}></script>
  </head>
  <body>
    <main>
      <header class="page-header">
        <div>
          <h1>Python Interview Prep</h1>
          <p class="sub">{problems.length} problems</p>
        </div>
        <div class="actions">
          <button id="theme-toggle" class="btn-icon" aria-label="Toggle theme">☾</button>
          <button id="random" class="btn-primary">Random</button>
          <a href="#" id="clear-all" class="muted-link">Clear saved</a>
        </div>
      </header>

      <ProblemList />
      <Footer />
    </main>

    <script define:vars={{ base, slugs }}>
      const btn = document.getElementById('random');
      btn?.addEventListener('click', () => {
        const slug = slugs[Math.floor(Math.random() * slugs.length)];
        location.href = `${base}problem/${slug}`;
      });
      const clear = document.getElementById('clear-all');
      clear?.addEventListener('click', (e) => {
        e.preventDefault();
        if (!confirm('Clear all saved solutions from this browser?')) return;
        const keys = [];
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && (k.startsWith('solution:') || k.startsWith('skeleton_hash:'))) keys.push(k);
        }
        keys.forEach((k) => localStorage.removeItem(k));
        alert(`Cleared ${keys.length} entries.`);
      });
    </script>

    <script>
      import { attachThemeToggle } from '../lib/theme.ts';
      attachThemeToggle('theme-toggle');
    </script>

    <style is:global>
      body {
        max-width: 820px;
        padding: 1rem 1.25rem;
      }
      h1 { font-size: 22px; font-weight: 600; margin: 0; }
      .sub { color: var(--muted); margin: .15rem 0 0 0; font-size: 13px; }
      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
      }
      .actions { display: flex; gap: .6rem; align-items: center; }
    </style>
  </body>
</html>
